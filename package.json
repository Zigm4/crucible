{
  "name": "crucible",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Crucible - on-chain blends and drops for WAX, without depending on the (defunct) NeftyBlocks website.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:verify": "vite build --config vite.lib.config.mjs",
    "verify:createblend": "npm run build:verify && node scripts/verify-createblend.mjs",
    "verify:createupgrade": "npm run build:verify && node scripts/verify-createupgrade.mjs",
    "verify:lab": "npm run build:verify && node scripts/verify-lab.mjs"
  },
  "dependencies": {
    "@wharfkit/session": "^1.4.0",
    "@wharfkit/web-renderer": "^1.4.0",
    "@wharfkit/wallet-plugin-anchor": "^1.4.0",
    "@wharfkit/wallet-plugin-cloudwallet": "^1.4.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
