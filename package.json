{
  "name": "crucible",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Crucible - on-chain blends and drops for WAX, without depending on the (defunct) NeftyBlocks website.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:verify": "vite build --config vite.lib.config.mjs",
    "verify:createblend": "npm run build:verify && node scripts/verify-createblend.mjs",
    "verify:createupgrade": "npm run build:verify && node scripts/verify-createupgrade.mjs",
    "verify:lab": "npm run build:verify && node scripts/verify-lab.mjs",
    "verify:contractauth": "npm run build:verify && node scripts/verify-contract-auth.mjs",
    "verify:names": "npm run build:verify && node scripts/verify-names.mjs"
  },
  "dependencies": {
    "@wharfkit/session": "^4.0.2",
    "@wharfkit/web-renderer": "^4.0.2",
    "@wharfkit/wallet-plugin-anchor": "^4.0.2",
    "@wharfkit/wallet-plugin-cloudwallet": "^4.0.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  }
}
