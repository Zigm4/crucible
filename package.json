{
  "name": "crucible",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Crucible - on-chain blends and drops for WAX, without depending on the (defunct) NeftyBlocks website.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:verify": "vite build --config vite.lib.config.mjs",
    "verify:createblend": "npm run build:verify && node scripts/verify-createblend.mjs",
    "verify:createupgrade": "npm run build:verify && node scripts/verify-createupgrade.mjs",
    "verify:lab": "npm run build:verify && node scripts/verify-lab.mjs",
    "verify:contractauth": "npm run build:verify && node scripts/verify-contract-auth.mjs",
    "verify:names": "npm run build:verify && node scripts/verify-names.mjs",
    "verify:attributes": "npm run build:verify && node scripts/verify-attributes.mjs",
    "verify:media": "npm run build:verify && node scripts/verify-media.mjs",
    "verify:simulate": "npm run build:verify && node scripts/verify-simulate.mjs",
    "verify:waxdao-holdings": "npm run build:verify && node scripts/verify-waxdao-holdings.mjs",
    "verify:access-lists": "npm run build:verify && node scripts/verify-access-lists.mjs",
    "verify:upgrade-fee": "npm run build:verify && node scripts/verify-upgrade-fee.mjs",
    "verify:change": "npm run build:verify && node scripts/verify-change.mjs",
    "verify:holder-gates": "npm run build:verify && node scripts/verify-holder-gates.mjs",
    "verify:signed-recently": "npm run build:verify && node scripts/verify-signed-recently.mjs",
    "verify:drop-ram": "npm run build:verify && node scripts/verify-drop-ram.mjs",
    "verify:nefty-leftovers": "npm run build:verify && node scripts/verify-nefty-leftovers.mjs"
  },
  "dependencies": {
    "@wharfkit/session": "^4.0.2",
    "@wharfkit/web-renderer": "^4.0.2",
    "@wharfkit/wallet-plugin-anchor": "^4.0.2",
    "@wharfkit/wallet-plugin-cloudwallet": "^4.0.2"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  }
}
